---

---

<div class="relative w-full max-w-115">
  <!-- Decorative blurred circles behind the card -->
  <div
    class="bg-periwinkle absolute -top-10 -right-8 h-52 w-52 rounded-full opacity-90 blur-sm"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-blush absolute -bottom-8 -left-6 h-36 w-36 rounded-full opacity-80 blur-sm"
    aria-hidden="true"
  >
  </div>

  <!-- Terminal window -->
  <div
    role="img"
    aria-label="A terminal-style introduction: Makayla Ferrell — software engineer, ethical hacker, educator, and QueryLock founder."
    class="border-line bg-surface relative overflow-hidden rounded-2xl border shadow-xl ring-1 ring-black/5"
  >
    <!-- Title bar -->
    <div aria-hidden="true" class="border-line bg-bg flex items-center gap-1.5 border-b px-4 py-3">
      <span class="h-3 w-3 rounded-full bg-[#FF5F57]"></span>
      <span class="h-3 w-3 rounded-full bg-[#FEBC2E]"></span>
      <span class="h-3 w-3 rounded-full bg-[#28C840]"></span>
      <span class="text-muted ml-auto font-mono text-[11px]">makayla@decoded: ~</span>
    </div>

    <!-- Terminal body -->
    <div aria-hidden="true" class="px-5 py-5 font-mono text-[13px] leading-relaxed">
      <!-- whoami -->
      <div class="flex items-start gap-2">
        <span class="text-accent select-none">$</span>
        <span class="text-brand">whoami</span>
      </div>
      <div class="text-muted mt-0.5 ml-4">makayla_ferrell</div>

      <!-- cat roles.txt -->
      <div class="mt-3 flex items-start gap-2">
        <span class="text-accent select-none">$</span>
        <span class="text-brand">cat roles.txt</span>
      </div>
      <ul class="mt-0.5 ml-4 list-none space-y-0.5 p-0">
        <li><span class="text-muted">-</span> <span class="text-brand">Software_Engineer</span></li>
        <li><span class="text-muted">-</span> <span class="text-brand">Ethical_Hacker</span></li>
        <li><span class="text-muted">-</span> <span class="text-brand">Educator</span></li>
        <li>
          <span class="text-muted">-</span>
          <span class="text-brand">QueryLock_Founder</span>
          <span class="text-[#28C840]"> ✓</span>
        </li>
      </ul>

      <!-- decode_life.sh -->
      <div class="mt-3 flex items-start gap-2">
        <span class="text-accent select-none">$</span>
        <span class="text-brand">./decode_life.sh</span>
      </div>
      <div class="text-muted mt-0.5 ml-4">
        Decoding... <span class="text-accent">████████████</span> 100%
      </div>
      <div class="ml-4 text-[#28C840]">Access granted. ✓</div>

      <!-- cursor blink -->
      <div class="mt-3 flex items-start gap-2">
        <span class="text-accent select-none">$</span>
        <span class="bg-accent inline-block h-3.5 w-2 animate-pulse opacity-80" aria-hidden="true"
        ></span>
      </div>
    </div>
  </div>
</div>
