---
import { Mail, ExternalLink } from "@lucide/astro";
---

<section class="bg-accent-deep px-5 py-20 text-center sm:px-8">
  <div class="mx-auto max-w-2xl">
    <!-- Eyebrow -->
    <p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-white/50">
      Get in touch
    </p>

    <!-- Headline -->
    <h2 class="mb-4 font-serif text-3xl leading-tight text-white sm:text-4xl md:text-[2.75rem]">
      Let's <em class="italic">decode</em> something together.
    </h2>

    <!-- Body -->
    <p class="mb-10 font-sans text-base leading-relaxed text-white/70">
      Have a question, a collaboration in mind, or just want to talk security?
      I'd love to hear from you.
    </p>

    <!-- Pill buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="mailto:makayla.b.ferrell@gmail.com"
        class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-2.5 font-sans text-sm font-semibold text-accent-deep transition-opacity hover:opacity-90"
      >
        <Mail size={15} />
        Email
      </a>
      <a
        href="https://medium.com/@makayladecoded"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-2.5 font-sans text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20"
      >
        <ExternalLink size={15} />
        Medium
      </a>
      <a
        href="https://linkedin.com/in/makaylaferrell"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-2.5 font-sans text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20"
      >
        <ExternalLink size={15} />
        LinkedIn
      </a>
    </div>
  </div>
</section>
