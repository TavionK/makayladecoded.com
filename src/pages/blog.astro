---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";
import { posts } from "../data/posts";
---

<Layout
  title="Blog"
  description="Write-ups from cloud pentesting, CTFs & AI red-teaming by Makayla Ferrell."
  active="blog"
>
  <!-- ─── Blog header band ─── -->
  <section
    aria-label="Blog introduction"
    class="px-5 py-16 sm:px-8 sm:py-20"
    style="background: linear-gradient(160deg, #f3ecf8 0%, #efe8f8 50%, #fbf7f1 100%);"
  >
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-brand mb-4 font-serif text-4xl leading-tight sm:text-5xl md:text-[3.25rem]">
        My <span class="text-accent">Blog</span>
      </h1>
      <p class="text-muted font-sans text-base leading-relaxed sm:text-lg">
        Write-ups from cloud pentesting, CTFs &amp; AI red-teaming. Each post opens the full
        write-up on Medium.
      </p>
    </div>
  </section>

  <!-- ─── Posts grid ─── -->
  <section aria-label="Blog posts" class="px-5 py-16 sm:px-8 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <ul
        id="blog-posts-grid"
        class="grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3"
        role="list"
      >
        {
          posts.map((post) => (
            <li>
              <BlogCard post={post} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script is:inline>
    let imgs = document.querySelectorAll("#blog-posts-grid img");
    let limit = window.matchMedia("(min-width: 768px)").matches ? 3 : 1;
    for (let i = 0; i < limit && i < imgs.length; i++) {
      imgs[i].loading = "eager";
    }
  </script>
</Layout>
