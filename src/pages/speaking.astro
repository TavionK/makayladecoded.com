---
import Layout from "../layouts/Layout.astro";
import { Image } from "@lucide/astro";
import SpeakingCard from "../components/SpeakingCard.astro";
---

<Layout
  title="Speaking"
  description="Invite Makayla Ferrell to speak at your event — cybersecurity topics made clear and accessible for every audience."
  active="speaking"
>
  <section
    aria-labelledby="speaking-heading"
    class="overflow-hidden px-5 pt-16 pb-20 sm:px-8 md:pt-24"
  >
    <div class="mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Text column -->
        <div class="max-w-xl">
          <!-- Badge -->
          <div
            class="border-line bg-surface text-muted mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 font-mono text-xs shadow-sm"
          >
            <span class="h-2 w-2 shrink-0 rounded-full bg-[#28C840]" aria-hidden="true"></span>
            SPEAKING
          </div>

          <!-- Headline -->
          <h1
            id="speaking-heading"
            class="text-brand mb-6 font-serif text-4xl leading-[1.15] sm:text-5xl md:text-[3rem]"
          >
            Cybersecurity that makes sense to every audience.
          </h1>

          <!-- Body -->
          <p class="text-muted mb-8 font-sans text-base leading-relaxed">
            Makayla Ferrell is a former software developer turned penetration tester, educator, and
            founder of QueryLock. She makes complex cybersecurity and technology topics clear,
            useful, and relevant for audiences ranging from developers and security teams to
            students, business leaders, and people with no technical background.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col items-start gap-3">
            <a
              href="/contact"
              class="focus-ring bg-accent hover:bg-accent-deep inline-flex items-center gap-1.5 rounded-full px-7 py-3 font-sans text-sm font-semibold text-white transition-colors"
            >
              Invite Makayla to Speak <span aria-hidden="true">→</span>
            </a>
            <a
              href="#engagements"
              class="focus-ring border-accent text-accent hover:bg-tint inline-flex items-center rounded-full border px-7 py-3 font-sans text-sm font-semibold transition-colors"
            >
              View Speaking Experience
            </a>
          </div>
        </div>

        <!-- Image placeholder column -->
        <div class="flex justify-center lg:justify-end">
          <div
            class="border-line bg-surface flex w-full max-w-sm flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed py-24 lg:max-w-none"
            aria-label="Placeholder for professional photo of Makayla speaking"
          >
            <Image size={32} class="text-line" aria-hidden="true" />
            <p class="text-muted font-sans text-xs">professional photo of Makayla speaking</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ─── Perspective section ─── -->
  <section
    id="experience"
    aria-labelledby="perspective-heading"
    class="bg-band px-5 py-16 sm:px-8 sm:py-24"
  >
    <div class="mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Text column -->
        <div class="max-w-xl">
          <h2
            id="perspective-heading"
            class="text-brand mb-6 font-serif text-3xl leading-tight sm:text-4xl md:text-[2.5rem]"
          >
            A perspective from both sides of software security.
          </h2>
          <div class="text-muted space-y-5 font-sans text-base leading-relaxed">
            <p>
              Before testing applications for vulnerabilities, Makayla built software herself. That
              experience gives her a practical understanding of how developers think, the pressures
              engineering teams work under, and why security guidance can succeed or fail in the
              real world.
            </p>
            <p>
              Her work in penetration testing showed her the other side: how attackers find
              weaknesses, how small decisions become security risks, and how often the same problems
              appear because the people building and using technology were never given the context
              to understand them.
            </p>
            <p>
              Whether the room is full of developers, security professionals, students, executives,
              or people who have never written a line of code, Makayla meets the audience where they
              are and makes the technology understandable without talking down to them.
            </p>
          </div>
        </div>

        <!-- Journey visual column -->
        <div class="flex justify-center lg:justify-end">
          <div class="w-full max-w-sm rounded-2xl bg-white px-10 py-14 lg:max-w-none">
            <ol
              class="flex list-none flex-col items-center gap-0 p-0"
              aria-label="Makayla's career journey"
            >
              {
                ["DEVELOPER", "PENETRATION TESTER", "EDUCATOR", "FOUNDER"].map((label, i, arr) => (
                  <>
                    <li class="bg-band text-accent w-full rounded-full py-2.5 text-center font-sans text-xs font-bold">
                      {label}
                    </li>
                    {i < arr.length - 1 && (
                      <li
                        aria-hidden="true"
                        class="text-muted py-2 text-base leading-none select-none"
                      >
                        ↓
                      </li>
                    )}
                  </>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── What I speak about ─── -->
  <section aria-labelledby="topics-heading" class="px-5 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <!-- Section header -->
      <h2 id="topics-heading" class="text-brand mb-4 font-serif text-3xl sm:text-4xl">
        What I speak about
      </h2>
      <p class="text-muted mb-12 max-w-2xl font-sans text-base leading-relaxed">
        Cybersecurity does not have one audience. Makayla tailors the depth, examples, and language
        of each session to the people in the room, from deeply technical teams to audiences who
        simply want to understand the technology shaping their lives and work.
      </p>

      <!-- Cards grid -->
      <div class="grid gap-6 sm:grid-cols-2">
        <SpeakingCard
          title="Making Cybersecurity Make Sense"
          body="Cybersecurity affects everyone, but it is often explained as if everyone already understands the technology behind it. Makayla breaks complex security concepts down without unnecessary jargon, helping audiences understand how technology works, where risk comes from, and why security decisions matter."
          audience="General audiences, students, universities, employee events, leadership groups, conferences, and community organizations."
        />
        <SpeakingCard
          title="Security Through a Developer's Lens"
          body="Before testing software for vulnerabilities, Makayla built it. Her talks explore the disconnect that can form between development and security teams, why secure-development guidance sometimes fails, how vulnerabilities are introduced, and how better education can help teams build more secure software."
          audience="Developers, engineering teams, AppSec teams, DevSecOps communities, technical leaders, and technology conferences."
        />
        <SpeakingCard
          title="Ethical Hacking & Penetration Testing"
          body="What does an ethical hacker actually do? Makayla brings real-world offensive-security experience into approachable talks about penetration testing, attack paths, vulnerabilities, hacker methodology, and what organizations can learn from seeing their systems through an attacker's eyes."
          audience="Technical teams, business leaders, students, aspiring cybersecurity professionals, and curious general audiences."
        />
        <SpeakingCard
          title="Cybersecurity Education & the Knowledge Gap"
          body="Security problems are often treated as technology problems when many begin as knowledge problems. Makayla explores how we teach cybersecurity, why important lessons fail to stick, and what changes when people actually understand the systems, vulnerabilities, and safeguards they interact with."
          audience="Conferences, educators, leadership audiences, security teams, developers, universities, and organizations focused on security culture."
        />
      </div>
    </div>
  </section>

  <!-- ─── Featured Talk ─── -->
  <section aria-labelledby="featured-talk-heading" class="bg-brand px-5 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <!-- Label -->
      <p class="text-tint mb-5 font-mono text-xs font-bold uppercase">Featured Talk</p>

      <!-- Heading -->
      <h2
        id="featured-talk-heading"
        class="mb-8 max-w-3xl font-serif text-3xl leading-tight text-white italic"
      >
        Most Security Problems Are Knowledge Problems
      </h2>

      <!-- Body -->
      <div class="mb-12 max-w-3xl space-y-5 font-sans text-base leading-relaxed text-white">
        <p>
          Organizations invest heavily in security tools, testing, policies, and training, yet many
          of the same problems continue to appear. Developers recreate familiar vulnerabilities.
          Employees work around safeguards they do not understand. Security teams repeat the same
          recommendations year after year.
        </p>
        <p>
          This talk explores a simple idea: many security problems begin as knowledge problems.
          Drawing on experience as a software developer, penetration tester, and educator, Makayla
          examines what changes when we stop teaching people only what rule to follow and start
          helping them understand how the technology works, why the risk exists, and what their role
          is in preventing it.
        </p>
        <p>
          Audiences leave with a more practical way to think about security education,
          communication, and the gap between knowing a rule and understanding enough to make better
          decisions.
        </p>
      </div>

      <!-- Meta columns -->
      <div class="mb-10 grid max-w-3xl gap-8 sm:grid-cols-2 sm:gap-12">
        <div>
          <p class="text-tint mb-3 font-mono text-[0.65rem] font-bold uppercase">Best For</p>
          <p class="font-sans text-sm leading-relaxed text-white">
            Cybersecurity conferences, developer conferences, technology events, leadership
            audiences, universities, and company-wide learning events.
          </p>
        </div>
        <div>
          <p class="text-tint mb-3 font-mono text-[0.65rem] font-bold uppercase">
            Available Formats
          </p>
          <p class="font-sans text-sm leading-relaxed text-white">
            Conference session, keynote-style talk, webinar, or customized organizational session.
          </p>
        </div>
      </div>

      <!-- CTA -->
      <a
        href="/contact"
        class="focus-ring inline-flex items-center gap-1.5 rounded-full bg-white px-7 py-3 font-sans text-sm font-semibold text-[#0f1117] transition-colors hover:bg-gray-100"
      >
        Ask about this talk <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ─── Selected speaking & instruction ─── -->
  <section id="engagements" aria-labelledby="engagements-heading" class="px-5 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 id="engagements-heading" class="text-brand mb-4 font-serif text-3xl sm:text-4xl">
        Selected speaking &amp; instruction
      </h2>
      <p class="text-muted mb-14 max-w-2xl font-sans text-base leading-relaxed">
        Makayla has delivered technical talks, workshops, panels, recurring classes, and hands-on
        cybersecurity instruction for conference, corporate, university, and community audiences.
      </p>

      <!-- Timeline -->
      <div class="flex flex-col gap-0">
        {
          [
            {
              year: "2026",
              featured: true,
              title: "Penetration Testing Uncovered: A Guide to Tools and Techniques",
              org: "Jefferson Wells / ManpowerGroup",
              role: "Co-Presenter",
              description:
                "Technical webinar covering penetration testing methodology, common attack paths, real-world tools and techniques, and risk-based findings.",
            },
            {
              year: "2026",
              featured: true,
              title: "Penetration Testing Workshop",
              org: "Blacks in Cybersecurity, Black Women in Cyber",
              role: "Workshop Instructor",
              description:
                "Hands-on penetration testing instruction for participants in the Black Women in Cyber program.",
            },
            {
              year: "2025",
              featured: false,
              title: "Succeeding in Cybersecurity: Lessons from the Front Lines",
              org: "Jefferson Wells / ManpowerGroup",
              role: "Panelist",
              description:
                "Industry panel on cybersecurity careers, professional challenges, the evolving threat landscape, and lessons from the field. September 23, 2025.",
            },
            {
              year: "2025",
              featured: false,
              title: "National Cyber League Coach",
              org: "Prince George's Community College / WCyS Student Chapter",
              role: "Coach & Technical Instructor",
              description:
                "Led weekly CTF preparation sessions and created lesson plans covering OSINT, web application security, scanning, cryptography, password cracking, enumeration, network analysis, log analysis, and digital forensics.",
            },
            {
              year: "2025",
              featured: false,
              title: "Breaking into Tech: Strategies for Landing Your First IT Job",
              org: "Prince George's Community College STEM Week",
              role: "Panelist",
              description: "Career panel for students exploring technology and cybersecurity careers.",
            },
            {
              year: "2023",
              featured: true,
              title: "Ethical Hacking... Explained with Makayla",
              org: "BlackGirlsHack",
              role: "Lead Instructor",
              description:
                "Led a recurring beginner-focused ethical hacking series with at least 20 scheduled sessions identified across 2023.",
            },
            {
              year: "2022",
              featured: true,
              title: "Network Penetration Testing Workshop",
              org: "DEF CON 30, Girls Hack Village",
              role: "Workshop Instructor",
              description:
                "Co-led a hands-on network penetration testing workshop at DEF CON 30 in Las Vegas.",
            },
            {
              year: "2022",
              featured: false,
              title: "OSCP Study Group",
              org: "BlackGirlsHack",
              role: "Co-Instructor / Study Group Lead",
              description:
                "Co-led a recurring weekly OSCP preparation group from June through August 2022.",
            },
            {
              year: "2021",
              featured: false,
              title: "Student Cloud Security Initiative",
              org: "Cloud Security Alliance LA/SoCal",
              role: "Co-Presenter",
              description: "Participated in a student-focused cloud security education initiative.",
            },
            {
              year: "2021",
              featured: false,
              title:
                "Baby-Step Giant-Step Algorithm and Discrete Logs Applied to Public-Private Encryption",
              org: "University of Mary Washington Research & Creativity Day",
              role: "Oral Research Presenter",
              description:
                "Presented cryptography research on discrete logarithms and public-private encryption.",
            },
          ].map((item, i, arr) => {
            const prevYear = i > 0 ? arr[i - 1].year : null;
            const showYear = item.year !== prevYear;
            return (
              <div class="grid grid-cols-[3rem_1fr] gap-x-6 sm:grid-cols-[4.5rem_1fr]">
                <!-- Year column -->
                <div class="pt-5">
                  {showYear ? (
                    <span class="text-muted font-mono text-sm font-semibold">{item.year}</span>
                  ) : (
                    <span aria-hidden="true" />
                  )}
                </div>

                <!-- Content column -->
                <div
                  class:list={[
                    "border-line mb-2 rounded-2xl border p-5",
                    item.featured ? "bg-tint" : "bg-surface",
                  ]}
                >
                  {item.featured && (
                    <div class="text-accent mb-2 flex items-center gap-1.5 font-mono text-[0.6rem] font-bold tracking-widest uppercase">
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 10 10"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M5 0l1.2 3.8H10L6.9 6.1 8.1 10 5 7.6 1.9 10l1.2-3.9L0 3.8h3.8z" />
                      </svg>
                      Featured Engagement
                    </div>
                  )}
                  <h3 class="text-brand mb-1 font-serif text-base font-semibold leading-snug sm:text-lg">
                    {item.title}
                  </h3>
                  <p class="text-muted mb-3 font-sans text-xs">
                    {item.org} &middot; {item.role}
                  </p>
                  <p class="text-muted font-sans text-sm leading-relaxed">{item.description}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
