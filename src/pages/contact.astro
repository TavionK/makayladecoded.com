---
import Layout from "../layouts/Layout.astro";
import { Mail } from "@lucide/astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="Contact"
  description="Get in touch with Makayla Ferrell — software engineer and ethical hacker."
  active="contact"
>
  <div class="relative min-h-[calc(100vh-64px-89px)] overflow-hidden px-5 py-20 sm:px-8">
    <!-- Decorative circle — top right -->
    <div
      class="bg-periwinkle pointer-events-none absolute -top-16 -right-24 h-64 w-64 rounded-full opacity-70 sm:h-80 sm:w-80"
      aria-hidden="true"
    >
    </div>
    <!-- Decorative circle — bottom left -->
    <div
      class="bg-blush pointer-events-none absolute -bottom-10 -left-16 h-32 w-32 rounded-full opacity-60 sm:h-52 sm:w-52"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-3xl">
      <!-- Headline -->
      <div class="mb-12 text-center">
        <h1 class="text-brand mb-4 font-serif text-4xl leading-tight sm:text-5xl md:text-[3.25rem]">
          Contact <span class="text-accent">Me</span>
        </h1>
        <p class="text-muted mx-auto max-w-md font-sans text-base leading-relaxed">
          Got a question, a collaboration in mind, or just want to talk security? I'd love to hear
          from you — pick whichever works best.
        </p>
      </div>

      <!-- Contact cards -->
      <ul class="m-0 grid list-none gap-5 p-0 sm:grid-cols-3" role="list">
        <!-- Email -->
        <li>
          <a
            href="mailto:makayla.b.ferrell@gmail.com"
            aria-label="Email Makayla at makayla.b.ferrell@gmail.com"
            class="group border-line bg-surface flex flex-row items-center gap-4 rounded-2xl border p-5 text-left shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md sm:flex-col sm:items-center sm:gap-3 sm:p-7 sm:text-center"
          >
            <span
              aria-hidden="true"
              class="bg-tint text-accent group-hover:bg-accent flex h-14 w-14 items-center justify-center rounded-full transition-colors group-hover:text-white"
            >
              <Mail size={22} aria-hidden="true" />
            </span>
            <div class="sm:text-center">
              <p class="text-brand mb-1 font-sans text-sm font-semibold">Email</p>
              <p class="text-muted font-mono text-xs">makayla.b.ferrell@gmail.com</p>
            </div>
          </a>
        </li>

        <!-- Medium -->
        <li>
          <a
            href="https://medium.com/@makayla.b.ferrell"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View Makayla's Medium profile (opens in a new tab)"
            class="group border-line bg-surface flex flex-row items-center gap-4 rounded-2xl border p-5 text-left shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md sm:flex-col sm:items-center sm:gap-3 sm:p-7 sm:text-center"
          >
            <span
              aria-hidden="true"
              class="bg-tint text-accent group-hover:bg-accent flex h-14 w-14 items-center justify-center rounded-full transition-colors group-hover:text-white"
            >
              <Icon name="simple-icons:medium" size={22} aria-hidden="true" />
            </span>
            <div class="sm:text-center">
              <p class="text-brand mb-1 font-sans text-sm font-semibold">Medium</p>
              <p class="text-muted font-mono text-xs">@makayla.b.ferrell</p>
            </div>
          </a>
        </li>

        <!-- LinkedIn -->
        <li>
          <a
            href="https://www.linkedin.com/in/makayla-ferrell/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View Makayla's LinkedIn profile (opens in a new tab)"
            class="group border-line bg-surface flex flex-row items-center gap-4 rounded-2xl border p-5 text-left shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md sm:flex-col sm:items-center sm:gap-3 sm:p-7 sm:text-center"
          >
            <span
              aria-hidden="true"
              class="bg-tint text-accent group-hover:bg-accent flex h-14 w-14 items-center justify-center rounded-full transition-colors group-hover:text-white"
            >
              <Icon name="simple-icons:linkedin" size={22} aria-hidden="true" />
            </span>
            <div class="sm:text-center">
              <p class="text-brand mb-1 font-sans text-sm font-semibold">LinkedIn</p>
              <p class="text-muted font-mono text-xs">/in/makayla-ferrell</p>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </div>
</Layout>
